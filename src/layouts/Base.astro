---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  activeTag?: string;
  activePage?: 'home' | 'about';
  image?: string;
}
const { title, description = SITE_DESCRIPTION, activeTag, activePage, image } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/logo.png', Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Nanum+Myeongjo:wght@400;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Playfair+Display:ital,wght@1,500;1,700&display=swap"
    />
    <script is:inline>
      // Restore the desktop rail state before paint. (On phones the menu is a drawer that starts closed.)
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('sb-collapsed') === '1') document.documentElement.classList.add('sb-collapsed');
      } catch {}
    </script>
  </head>
  <body>
    <div class="shell">
      <Sidebar activeTag={activeTag} activePage={activePage} />
      <main>
        <header class="mbar">
          <button class="mbar-btn" type="button" data-open-menu aria-label="메뉴 열기">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <a class="mbar-brand" href="/"><img src="/logo.png" alt="" />{SITE_TITLE}</a>
          <button class="mbar-btn mbar-search" type="button" data-open-search aria-label="검색">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </header>
        <div class="inner"><slot /></div>
      </main>
    </div>
    <div class="progress" aria-hidden="true"></div>
    <Search />
    <script>
      // Fade/slide content in as it scrolls into view.
      const items = document.querySelectorAll('.tsec, .tlist a, .subs a, .pnav a, .links li, .prose > *');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el, n) => {
          (el as HTMLElement).style.setProperty('--d', `${Math.min(n % 6, 5) * 60}ms`);
          el.classList.add('rv');
          io.observe(el);
        });
      }
      // Reading progress on post pages.
      const bar = document.querySelector<HTMLElement>('.progress');
      if (bar && document.querySelector('.prose')) {
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
        };
        bar.classList.add('on');
        addEventListener('scroll', update, { passive: true });
        update();
      }
      // Owner tools (write / edit / delete) — on with ?owner=1, off with ?owner=0. Remembered per browser.
      // Only hides buttons from visitors; GitHub checks the real permission.
      try {
        const flag = new URLSearchParams(location.search).get('owner');
        if (flag === '1') localStorage.setItem('sukk-owner', '1');
        if (flag === '0') localStorage.removeItem('sukk-owner');
        if (localStorage.getItem('sukk-owner') === '1') document.querySelectorAll<HTMLElement>('[data-owner]').forEach((el) => (el.hidden = false));
      } catch {}
      document.querySelectorAll<HTMLAnchorElement>('[data-confirm]').forEach((a) =>
        a.addEventListener('click', (e) => { if (!confirm(a.dataset.confirm!)) e.preventDefault(); }),
      );
      // New post: open GitHub's new-file page with the frontmatter template filled in (today's date).
      document.querySelectorAll<HTMLAnchorElement>('[data-new-post]').forEach((a) =>
        a.addEventListener('click', () => {
          const d = new Date();
          const day = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
          const tpl = `---\ntitle: "제목"\ndescription: "목록에 보일 한두 줄 요약"\ndate: ${day}\ntags: [프로젝트]   # 첫 번째 = 카테고리(프로젝트·일상·운동·퀀트·차익거래), 두 번째부터 #태그\n# cover: /covers/파일이름.png\n---\n\n본문은 마크다운으로.\n`;
          a.href = `${a.dataset.newPost}?filename=${day}-new-post.md&value=${encodeURIComponent(tpl)}`;
        }),
      );
      // Phone header hides while scrolling down, comes back when scrolling up.
      const mbar = document.querySelector('.mbar');
      let last = scrollY;
      addEventListener('scroll', () => {
        const y = scrollY;
        mbar?.classList.toggle('hide', y > last && y > 80);
        last = y;
      }, { passive: true });
    </script>
  </body>
</html>
