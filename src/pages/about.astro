---
import Base from '../layouts/Base.astro';
import BackBar from '../components/BackBar.astro';
import { LINKS, SITE_TAGLINE, SITE_TITLE } from '../consts';

// 24x24 icon paths (GitHub / Instagram brand marks, paper-plane for DM)
const ICONS: Record<string, string> = {
  github: '<path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>',
  linkedin: '<rect x="2.5" y="2.5" width="19" height="19" rx="3.5" fill="none" stroke="currentColor" stroke-width="2"/><path fill="currentColor" d="M7 10h2.3v7H7zM8.15 6.3a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6M11 10h2.2v1c.4-.7 1.3-1.2 2.4-1.2 2.2 0 2.8 1.4 2.8 3.3V17h-2.3v-3.4c0-.9-.2-1.8-1.3-1.8s-1.5.8-1.5 1.8V17H11z"/>',
  instagram: '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.3" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor"/>',
  dm: '<path d="M21.5 2.5 10.8 13.2M21.5 2.5l-6.8 19-3.9-8.3-8.3-3.9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>',
};
---
<Base title="소개" activePage="about">
  <BackBar crumbs={[{ label: '홈', href: '/' }, { label: '소개' }]} />
  <section class="about">
    <img class="about-av" src="/logo.png" alt="" width="96" height="96" />
    <h1>{SITE_TITLE}</h1>
    <p class="about-tag">{SITE_TAGLINE}</p>
    <ul class="links">
      {LINKS.map((l) => {
        const ext = /^https?:/.test(l.href);
        return (
          <li>
            <a class:list={[{ primary: l.primary }]} href={l.href} {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>
              {l.icon && <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[l.icon]} />}
              <span class="l">{l.label}</span>
              {l.note && <span class="n">{l.note}</span>}
              <span class="ar">{ext ? '↗' : '→'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
  <footer class="site">© {new Date().getFullYear()} {SITE_TITLE}</footer>
</Base>
